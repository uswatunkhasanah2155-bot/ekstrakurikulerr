datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id_user  Int              @id @default(autoincrement())
  username String           @unique
  password String
  email    String?
  role     String           // 'admin', 'siswa', atau 'pembina'
  id_eskul Int?
  eskul    Ekstrakurikuler? @relation(fields: [id_eskul], references: [id_eskul])
  siswa    Siswa?
}

model Siswa {
  id_siswa      Int           @id @default(autoincrement())
  id_user       Int?          @unique
  nama_siswa    String
  id_kelas      Int?
  jenis_kelamin String
  foto          String?
  user          User?         @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  kelasData     Kelas?        @relation(fields: [id_kelas], references: [id_kelas])
  pendaftaran   Pendaftaran[]
}

model Kelas {
  id_kelas   Int      @id @default(autoincrement())
  nama_kelas String   @unique

  siswa      Siswa[]
}

model Ekstrakurikuler {
  id_eskul    Int           @id @default(autoincrement())
  nama_eskul  String
  slug        String?       @unique
  deskripsi   String?
  pembina     String?
  jadwal      String?
  foto        String?
  pendaftaran Pendaftaran[]
  galeri      GaleriEskul[]
  pembina_akun User[]       
}

model Pendaftaran {
  id_pendaftaran  Int           @id @default(autoincrement())
  id_siswa        Int             
  id_eskul        Int 
  tanggal         DateTime?   @default(now()) @db.Date            
  siswa           Siswa         @relation(fields: [id_siswa], references: [id_siswa], onDelete: Cascade)
  ekstrakurikuler Ekstrakurikuler @relation(fields: [id_eskul], references: [id_eskul], onDelete: Cascade)
}

model GaleriEskul {
  id_galeri       Int             @id @default(autoincrement())
  id_eskul        Int
  foto            String
  keterangan      String?
  is_featured     Boolean         @default(false)
  created_at      DateTime        @default(now())
  ekstrakurikuler Ekstrakurikuler @relation(fields: [id_eskul], references: [id_eskul], onDelete: Cascade)
}