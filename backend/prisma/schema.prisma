datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id_user  Int     @id @default(autoincrement())
  username String  @unique
  password String
  email    String?  
  role     String  // 'admin' atau 'siswa'
  siswa    Siswa?  
}

model Siswa {
  id_siswa      Int           @id @default(autoincrement())
  id_user       Int?          @unique
  nama_siswa    String
  kelas         String
  jenis_kelamin String
  foto          String?
  user          User?         @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  pendaftaran   Pendaftaran[]  
}

model Ekstrakurikuler {
  id_eskul    Int           @id @default(autoincrement())
  nama_eskul  String
  slug        String?       @unique
  deskripsi   String?
  pembina     String?
  jadwal      String?
  foto        String?
  pendaftaran Pendaftaran[]
  galeri      GaleriEskul[]
}

model Pendaftaran {
  id_pendaftaran  Int           @id @default(autoincrement())
  id_siswa        Int             
  id_eskul        Int 
  tanggal         DateTime?   @default(now()) @db.Date            
  siswa           Siswa         @relation(fields: [id_siswa], references: [id_siswa], onDelete: Cascade)
  ekstrakurikuler Ekstrakurikuler @relation(fields: [id_eskul], references: [id_eskul], onDelete: Cascade)
}

model GaleriEskul {
  id_galeri       Int             @id @default(autoincrement())
  id_eskul        Int
  foto            String
  keterangan      String?
  is_featured     Boolean         @default(false)
  created_at      DateTime        @default(now())
  ekstrakurikuler Ekstrakurikuler @relation(fields: [id_eskul], references: [id_eskul], onDelete: Cascade)
}